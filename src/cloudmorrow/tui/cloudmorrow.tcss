/* Cloudmorrow — the panes' own furniture. The frame around them (header,
   sidebar, panel, log, buttons, tables, dialogs) is in chrome.tcss, and the
   kit's in kit.tcss. Colours come from the registered theme, so $primary
   (Sky), $action (Lens) and friends are the palette in theme.py. */

Screen {
    background: $background;
    color: $foreground;
}

/* -- sign in and splash -------------------------------------------------- */
LoginScreen, SplashScreen {
    align: center middle;
}

#centre-column {
    width: auto;
    height: auto;
    align-horizontal: center;
}

#logo {
    width: auto;
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

#tagline, #splash-status {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#login-box {
    width: 100%;
    height: auto;
    box-sizing: border-box;
    border: round $line-bright;
    padding: 1 2;
    background: $surface;
}

#login-box Input {
    margin-bottom: 1;
}

#login-box Button {
    width: 100%;
}

#login-status {
    margin-top: 1;
    height: auto;
}

/* -- secrets: the vaults on the left, the picked vault's keys on the right -- */
#secrets-body {
    height: 1fr;
}

/* The list is the note tree's opposite number: same width, same rule down
   its right, and the same line in the theme colour when it has focus. */
#vault-list {
    width: 26;
    height: 1fr;
    padding: 0 0;
    background: transparent;
    border-right: solid $line;
    scrollbar-size-vertical: 1;
}

#vault-list:focus {
    border-right: solid $primary;
}

#vault-list > ListItem {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $foreground;
}

#vault-list > ListItem:hover {
    background: $panel;
}

#vault-list > ListItem.--highlight {
    background: $panel;
}

#vault-list:focus > ListItem.--highlight {
    background: $cloud 45%;
    color: $text;
}

#secret-detail {
    width: 1fr;
}

#vault-name {
    height: 1;
    padding: 0 2;
    background: transparent;
    color: $secondary;
    text-style: bold;
}

/* -- secrets ------------------------------------------------------------- */
.env-bar {
    height: 3;
    padding: 1 2 0 2;
}

.env-bar Button {
    height: 1;
    min-width: 4;
    margin-right: 1;
    border: none;
    padding: 0 2;
    color: $muted;
    background: transparent;
}

.env-bar Button:hover {
    color: $foreground;
    background: $line-bright;
}

/* The environment you are looking at: blue, because it is where you are —
   a blue fill with white on it, as the brand has its fills. */
.env-bar Button.-primary {
    color: white;
    background: $cloud;
    text-style: bold;
}

.env-bar Button.-primary:hover {
    background: $puff;
}

#secret-body {
    height: 1fr;
    padding: 1 2;
}

#secret-empty {
    padding: 2 2;
    color: $muted;
}

/* -- notes --------------------------------------------------------------- */
#notes-body {
    height: 1fr;
}

#note-tree {
    width: 26;
    background: transparent;
    border-right: solid $line;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

#note-tree:focus {
    border-right: solid $primary;
}

#editor-pane {
    width: 1fr;
}

#note-path {
    height: 1;
    padding: 0 2;
    background: transparent;
    color: $secondary;
    text-style: bold;
}

#editor {
    padding: 1 2;
    background: $background;
    scrollbar-size: 1 1;
}

#editor-row {
    height: 1fr;
}

/* The picture the cursor is on, beside the text. Hidden when there is none. */
#picture {
    width: 40%;
    height: 1fr;
    padding: 1 2;
    background: transparent;
    border-left: solid $line;
}

#picture-caption {
    height: auto;
    margin-bottom: 1;
}

/* auto on both sides is the one pairing textual-image fits to the panel
   whole, keeping the picture's shape; a fixed width leaves it no height. */
#picture .picture-image {
    width: auto;
    height: auto;
}

#editor:focus {
    background: $background;
}

/* -- chat ---------------------------------------------------------------- */
#chat-body {
    height: 1fr;
    padding: 1 0 0 0;
}

#channel-pane {
    width: 24;
    margin-right: 2;
}

#thread-pane {
    width: 1fr;
}

/* The conversation takes what is left once the title and the box you type
   in have had their rows. */
#thread-body {
    height: 1fr;
    padding: 0 1;
}

#chat-input {
    margin-top: 1;
}

/* The new-channel dialog: two fields, the kind side by side, and the people
   to tick underneath when the kind is Private. */
#channel-modal Input {
    margin-bottom: 1;
}

#channel-modal RadioSet {
    width: 100%;
    height: auto;
    layout: horizontal;
    border: none;
    padding: 0;
    background: transparent;
}

#channel-modal RadioButton {
    width: auto;
    margin-right: 2;
    background: transparent;
    border: none;
    padding: 0;
}

#channel-kind-note {
    height: auto;
    margin-bottom: 1;
}

#channel-people {
    height: auto;
}

/* Enough rows to pick from without the dialog running off a short terminal;
   past that the list scrolls inside itself. */
#channel-members {
    height: auto;
    max-height: 8;
    border: none;
    padding: 0;
    background: transparent;
}

#channel-people-note, #channel-complaint {
    height: auto;
}

/* Nothing to show: every tab switched off for this account. */
#nothing-showing {
    height: 1fr;
    padding: 2 3;
}

/* -- settings: the tabs this account wants ------------------------------- */
#settings-features-note, #settings-features {
    height: auto;
}

#settings-features-note {
    margin-bottom: 1;
}

/* -- the calendar -------------------------------------------------------- */
#calendar-body {
    height: 1fr;
    padding: 1 0 0 0;
}

#calendar-list {
    width: 24;
    margin-right: 2;
}

#month-pane {
    width: 1fr;
}

/* The month takes the top half; the day it is standing on takes the rest,
   and both scroll on their own. Eight rows is a header and six weeks of
   two-line cells, which is every month there is. */
#month-grid {
    height: 15;
}

#day-table {
    height: 1fr;
    margin-top: 1;
}

/* -- the event dialog ---------------------------------------------------- */
#event-modal Input {
    margin-bottom: 1;
}

#event-modal .event-when, #event-modal .event-allday {
    height: auto;
    margin-bottom: 1;
}

/* The captions sit in the same widths as the fields under them, so each
   word is over the box it names. */
#event-modal .event-labels {
    height: 1;
    margin-bottom: 0;
}

#event-modal .event-labels Static {
    width: 1fr;
    margin-right: 1;
    padding-left: 1;
}

#event-modal .event-labels .event-arrow {
    width: 3;
    margin-right: 1;
    padding: 0;
}

#event-modal .event-when Input {
    width: 1fr;
    margin: 0 1 0 0;
}

#event-modal .event-arrow {
    width: 3;
    content-align: center middle;
    color: $muted;
}

#event-modal .event-allday Switch {
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
}

#event-modal .event-allday-label {
    width: 10;
    padding: 0 1;
    content-align-vertical: middle;
}

#event-modal #label-last {
    width: 5;
    padding: 0 1;
    content-align-vertical: middle;
}

#event-modal .event-allday Input {
    width: 1fr;
}

#event-complaint {
    height: auto;
}

.pane-title {
    height: 1;
    color: $muted;
    text-style: bold;
}

/* The three password fields sit one under the other, and the error under them. */
#password-modal Input {
    margin-bottom: 1;
}

#password-error {
    margin: 0;
}

/* -- settings ------------------------------------------------------------ */
/* As tall as what it has to say, which is not much: one machine, one box. */
#settings-modal {
    height: auto;
}

#settings-machine {
    height: auto;
    margin-bottom: 1;
}

#settings-omarchy {
    height: auto;
    margin: 1 0 0 0;
}

#settings-bundle {
    height: auto;
    margin-bottom: 1;
}

#settings-modal Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#settings-modal Checkbox:focus {
    text-style: bold;
}

/* Whatever the machine has to report, the buttons stay where they are. */
#settings-body {
    height: auto;
    max-height: 16;
    background: transparent;
}

/* -- notifications ------------------------------------------------------- */
/* As tall as the list it is holding: nothing has happened on most days, and a
   box of empty rows would be a strange way to say so. Past fourteen rows the
   list scrolls inside instead, so the buttons stay on screen even on a short
   terminal.  */
#notifications-modal {
    height: auto;
}

#notifications-body {
    height: auto;
    max-height: 14;
    background: transparent;
}

#notifications-list {
    height: auto;
}

#search-results-wrapper {
    height: auto;
    max-height: 14;
    background: transparent;
}

#search-results {
    background: transparent;
    height: auto;
    max-height: 14;
}

.command-block {
    padding: 1;
    background: $panel;
    color: $primary;
    margin-bottom: 1;
}


#admin-features-note {
    height: auto;
    padding: 1 2 0 2;
}

#admin-feature-list {
    height: 1fr;
    padding: 1 2;
    background: $background;
    scrollbar-size-vertical: 1;
}

.feature-row {
    height: auto;
    margin-bottom: 1;
}

.feature-row Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

.feature-row Checkbox:focus {
    text-style: bold;
}

.feature-note {
    height: auto;
    padding-left: 4;
}

/* -- the account dialog -------------------------------------------------- */
#user-modal Input {
    margin-bottom: 1;
}

#user-modal RadioSet {
    width: 100%;
    height: auto;
    layout: horizontal;
    border: none;
    padding: 0;
    background: transparent;
}

#user-modal RadioButton {
    width: auto;
    margin-right: 2;
    background: transparent;
    border: none;
    padding: 0;
}

#user-role-note, #user-type-note {
    height: auto;
    margin-bottom: 1;
}

#user-modal Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#user-complaint {
    height: auto;
}
