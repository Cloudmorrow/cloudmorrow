/* Cloudmorrow — cool blues on near-black, with a cyan accent.
   Colours come from the registered theme, so $primary and friends are the
   palette in theme.py. */

Screen {
    background: $background;
    color: $foreground;
}

/* -- sign in and splash -------------------------------------------------- */
LoginScreen, SplashScreen {
    align: center middle;
}

#centre-column {
    width: auto;
    height: auto;
    align-horizontal: center;
}

#logo {
    width: auto;
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

#tagline, #splash-status {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#login-box {
    width: 100%;
    height: auto;
    box-sizing: border-box;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}

#login-box Input {
    margin-bottom: 1;
}

#login-box Button {
    width: 100%;
}

#login-status {
    margin-top: 1;
    height: auto;
}

/* -- the workspace frame ------------------------------------------------- */
#topbar {
    height: 1;
    background: $surface;
}

#topbar-left {
    width: 1fr;
}

#topbar-right {
    width: auto;
    height: 1;
    align-horizontal: right;
}

/* Buttons that have to live on a one-line bar: no border, no padding but the
   space either side of the label. The account is one of them: click your
   name to change your password. */
#topbar #open-admin, #topbar #open-settings, #topbar #open-notifications,
#topbar #topbar-account {
    height: 1;
    min-width: 0;
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $surface;
    color: $muted;
    text-style: none;
}

#topbar #open-admin:hover, #topbar #open-settings:hover,
#topbar #open-notifications:hover, #topbar #topbar-account:hover {
    background: $panel;
    color: $primary;
}

#topbar #open-admin:focus, #topbar #open-settings:focus,
#topbar #open-notifications:focus, #topbar #topbar-account:focus {
    color: $primary;
    text-style: bold;
}

/* The bell is the last thing on the line, so it keeps no right margin. */
#topbar #open-notifications {
    margin: 0;
}

/* Something to read: the bell says so rather than leaving it to the count. */
#topbar #open-notifications.has-unread {
    color: $warning;
    text-style: bold;
}

#main {
    height: 1fr;
}

/* -- tabs ---------------------------------------------------------------- */
Tabs {
    height: 2;
    background: $background;
}

Tab {
    padding: 0 2;
    color: $muted;
    background: transparent;
}

Tab:hover {
    color: $foreground;
    background: $panel;
}

Tab.-active, Tabs:focus Tab.-active {
    color: $primary;
    background: transparent;
    text-style: bold;
}

Underline > .underline--bar {
    color: $primary;
    background: $line;
}

Tabs > #tabs-list {
    min-height: 2;
}

#panes {
    height: 1fr;
    background: $background;
}

/* -- a pane's toolbar ---------------------------------------------------- */
.toolbar {
    height: 3;
    padding: 1 1 0 2;
    background: $background;
}

.toolbar Button {
    height: 1;
    min-width: 6;
    margin-right: 2;
    border: none;
    padding: 0 1;
    color: $muted;
    background: $panel;
}

.toolbar Button:hover {
    color: $foreground;
    background: $line-bright;
}

.toolbar Button.-primary {
    color: $primary;
    background: $primary 15%;
}

.toolbar Button.-primary:hover {
    color: $background;
    background: $primary;
}

.toolbar Button.-error:hover {
    color: $background;
    background: $error;
}

/* -- secrets: the vaults on the left, the picked vault's keys on the right -- */
#secrets-body {
    height: 1fr;
}

/* The list is the note tree's opposite number: same width, same rule down
   its right, and the same line in the theme colour when it has focus. */
#vault-list {
    width: 32;
    height: 1fr;
    padding: 1 0;
    background: $surface;
    border-right: solid $line;
    scrollbar-size-vertical: 1;
}

#vault-list:focus {
    border-right: solid $primary;
}

#vault-list > ListItem {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $foreground;
}

#vault-list > ListItem:hover {
    background: $panel;
}

#vault-list > ListItem.--highlight {
    background: $panel;
}

#vault-list:focus > ListItem.--highlight {
    background: $primary 20%;
}

#secret-detail {
    width: 1fr;
}

#vault-name {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $secondary;
}

/* -- secrets ------------------------------------------------------------- */
.env-bar {
    height: 3;
    padding: 1 2 0 2;
}

.env-bar Button {
    height: 1;
    min-width: 4;
    margin-right: 1;
    border: none;
    padding: 0 2;
    color: $muted;
    background: $panel;
}

.env-bar Button:hover {
    color: $foreground;
    background: $line-bright;
}

.env-bar Button.-primary {
    color: $background;
    background: $primary;
    text-style: bold;
}

#secret-body {
    height: 1fr;
    padding: 1 2;
}

#secret-empty {
    padding: 2 2;
    color: $muted;
}

/* -- notes --------------------------------------------------------------- */
#notes-body {
    height: 1fr;
}

#note-tree {
    width: 32;
    background: $surface;
    border-right: solid $line;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

#note-tree:focus {
    border-right: solid $primary;
}

#editor-pane {
    width: 1fr;
}

#note-path {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $secondary;
}

#editor {
    padding: 1 2;
    background: $background;
    scrollbar-size: 1 1;
}

#editor-row {
    height: 1fr;
}

/* The picture the cursor is on, beside the text. Hidden when there is none. */
#picture {
    width: 40%;
    height: 1fr;
    padding: 1 2;
    background: $surface;
    border-left: solid $line;
}

#picture-caption {
    height: auto;
    margin-bottom: 1;
}

/* auto on both sides is the one pairing textual-image fits to the panel
   whole, keeping the picture's shape; a fixed width leaves it no height. */
#picture .picture-image {
    width: auto;
    height: auto;
}

#editor:focus {
    background: $background;
}

/* -- tasks --------------------------------------------------------------- */
/* The boards, as a strip of tabs: which ones you have, without a click. The
   strip's own underline is the rule under it; a border here would be two. */
#board-bar {
    height: 2;
    padding: 0 1;
    background: $surface;
}

#board-nav {
    width: 1fr;
    height: 2;
    background: $surface;
}

#board-nav Tab {
    padding: 0 2;
}

#lanes {
    height: 1fr;
}

.lane {
    width: 1fr;
    border-right: solid $line;
}

.lane:last-of-type {
    border-right: none;
}

/* The lane a held card would land in, so a drop is never a guess. */
.lane.-drop-target {
    background: $panel;
}

.lane-head {
    height: 1;
    padding: 0 2;
    background: $surface;
}

.lane-body {
    height: 1fr;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

.task-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface;
    border-left: solid $line;
}

.task-card:hover {
    border-left: solid $secondary;
}

.task-card:focus {
    background: $panel;
    border-left: solid $primary;
}

/* Held, and on its way somewhere. */
.task-card.-dragging {
    background: $panel;
    border-left: solid $primary;
    text-style: bold;
}

#task-modal #task-body {
    height: 14;
    border: solid $line;
    background: $background;
}

#task-modal #task-title {
    margin-bottom: 1;
}

/* -- chat ---------------------------------------------------------------- */
#chat-body {
    height: 1fr;
    padding: 1 2;
}

#channel-pane {
    width: 32;
    margin-right: 2;
}

#thread-pane {
    width: 1fr;
}

/* The conversation takes what is left once the title and the box you type
   in have had their rows. */
#thread-body {
    height: 1fr;
    padding: 0 1;
}

#chat-input {
    margin-top: 1;
}

/* The new-channel dialog: two fields, the kind side by side, and the people
   to tick underneath when the kind is Private. */
#channel-modal Input {
    margin-bottom: 1;
}

#channel-modal RadioSet {
    width: 100%;
    height: auto;
    layout: horizontal;
    border: none;
    padding: 0;
    background: transparent;
}

#channel-modal RadioButton {
    width: auto;
    margin-right: 2;
    background: transparent;
    border: none;
    padding: 0;
}

#channel-kind-note {
    height: auto;
    margin-bottom: 1;
}

#channel-people {
    height: auto;
}

/* Enough rows to pick from without the dialog running off a short terminal;
   past that the list scrolls inside itself. */
#channel-members {
    height: auto;
    max-height: 8;
    border: none;
    padding: 0;
    background: transparent;
}

#channel-people-note, #channel-complaint {
    height: auto;
}

/* Nothing to show: every tab switched off for this account. */
#nothing-showing {
    height: 1fr;
    padding: 2 3;
}

/* -- settings: the tabs this account wants ------------------------------- */
#settings-features-note, #settings-features {
    height: auto;
}

#settings-features-note {
    margin-bottom: 1;
}

/* -- the calendar -------------------------------------------------------- */
#calendar-body {
    height: 1fr;
    padding: 1 2;
}

#calendar-list {
    width: 30;
    margin-right: 2;
}

#month-pane {
    width: 1fr;
}

/* The month takes the top half; the day it is standing on takes the rest,
   and both scroll on their own. Eight rows is a header and six weeks of
   two-line cells, which is every month there is. */
#month-grid {
    height: 15;
}

#day-table {
    height: 1fr;
    margin-top: 1;
}

/* -- the event dialog ---------------------------------------------------- */
#event-modal Input {
    margin-bottom: 1;
}

#event-modal .event-when, #event-modal .event-allday {
    height: auto;
    margin-bottom: 1;
}

/* The captions sit in the same widths as the fields under them, so each
   word is over the box it names. */
#event-modal .event-labels {
    height: 1;
    margin-bottom: 0;
}

#event-modal .event-labels Static {
    width: 1fr;
    margin-right: 1;
    padding-left: 1;
}

#event-modal .event-labels .event-arrow {
    width: 3;
    margin-right: 1;
    padding: 0;
}

#event-modal .event-when Input {
    width: 1fr;
    margin: 0 1 0 0;
}

#event-modal .event-arrow {
    width: 3;
    content-align: center middle;
    color: $muted;
}

#event-modal .event-allday Switch {
    height: 1;
    border: none;
    padding: 0;
    background: transparent;
}

#event-modal .event-allday-label {
    width: 10;
    padding: 0 1;
    content-align-vertical: middle;
}

#event-modal #label-last {
    width: 5;
    padding: 0 1;
    content-align-vertical: middle;
}

#event-modal .event-allday Input {
    width: 1fr;
}

#event-complaint {
    height: auto;
}

.pane-title {
    height: 1;
    color: $muted;
    text-style: bold;
}

/* -- files: two tabs of its own ------------------------------------------ */
#files-nav {
    height: 2;
    padding: 0 1;
}

#files-nav Tab {
    padding: 0 2;
}

#files-views {
    height: 1fr;
}

#shares-body {
    height: 1fr;
    padding: 1 2;
}

#backups-placeholder {
    padding: 2 3;
    color: $muted;
}

/* -- tables -------------------------------------------------------------- */
DataTable {
    height: 1fr;
    background: $surface;
    border: round $line;
    scrollbar-size: 1 1;
}

DataTable:focus {
    border: round $primary;
}

DataTable > .datatable--header {
    background: $panel;
    color: $muted;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: $primary 25%;
    color: $foreground;
}

DataTable > .datatable--hover {
    background: $panel;
}

/* -- modals -------------------------------------------------------------- */
ModalScreen {
    align: center middle;
    background: $background 70%;
}

.modal {
    width: 62;
    height: auto;
    box-sizing: border-box;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

.modal-wide {
    width: 82;
}

.modal-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.modal-detail {
    height: auto;
    color: $muted;
    margin: 1 0;
}

.modal-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 2;
}

/* The three password fields sit one under the other, and the error under them. */
#password-modal Input {
    margin-bottom: 1;
}

#password-error {
    margin: 0;
}

/* -- settings ------------------------------------------------------------ */
/* As tall as what it has to say, which is not much: one machine, one box. */
#settings-modal {
    height: auto;
}

#settings-machine {
    height: auto;
    margin-bottom: 1;
}

#settings-omarchy {
    height: auto;
    margin: 1 0 0 0;
}

#settings-bundle {
    height: auto;
    margin-bottom: 1;
}

#settings-modal Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#settings-modal Checkbox:focus {
    text-style: bold;
}

/* Whatever the machine has to report, the buttons stay where they are. */
#settings-body {
    height: auto;
    max-height: 16;
    background: transparent;
}

/* -- notifications ------------------------------------------------------- */
/* As tall as the list it is holding: nothing has happened on most days, and a
   box of empty rows would be a strange way to say so. Past fourteen rows the
   list scrolls inside instead, so the buttons stay on screen even on a short
   terminal.  */
#notifications-modal {
    height: auto;
}

#notifications-body {
    height: auto;
    max-height: 14;
    background: transparent;
}

#notifications-list {
    height: auto;
}

#search-results-wrapper {
    height: auto;
    max-height: 14;
    background: transparent;
}

#search-results {
    background: transparent;
    height: auto;
    max-height: 14;
}

.command-block {
    padding: 1;
    background: $panel;
    color: $primary;
    margin-bottom: 1;
}


/* -- administration ------------------------------------------------------ */
/* The menu is lit while its panel is the thing on screen, so the top bar
   says where you are. */
#topbar #open-admin.-open {
    color: $primary;
    background: $primary 15%;
    text-style: bold;
}

#workspace-view, #admin-view {
    height: 1fr;
}

#admin-head {
    height: 1;
    background: $surface;
    padding: 0 0 0 2;
}

#admin-title {
    width: 1fr;
    height: 1;
}

#admin-head #admin-back {
    height: 1;
    min-width: 0;
    width: auto;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $surface;
    color: $muted;
}

#admin-head #admin-back:hover {
    background: $panel;
    color: $primary;
}

/* The panel's own strip, quieter than the one the workspace wears. */
#admin-nav {
    height: 2;
    padding: 0 1;
}

#admin-nav Tab {
    padding: 0 2;
}

#admin-views {
    height: 1fr;
}

#admin-user-table {
    height: 1fr;
    padding: 0 2;
    background: $background;
}

#admin-features-note {
    height: auto;
    padding: 1 2 0 2;
}

#admin-feature-list {
    height: 1fr;
    padding: 1 2;
    background: $background;
    scrollbar-size-vertical: 1;
}

.feature-row {
    height: auto;
    margin-bottom: 1;
}

.feature-row Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

.feature-row Checkbox:focus {
    text-style: bold;
}

.feature-note {
    height: auto;
    padding-left: 4;
}

/* -- the account dialog -------------------------------------------------- */
#user-modal Input {
    margin-bottom: 1;
}

#user-modal RadioSet {
    width: 100%;
    height: auto;
    layout: horizontal;
    border: none;
    padding: 0;
    background: transparent;
}

#user-modal RadioButton {
    width: auto;
    margin-right: 2;
    background: transparent;
    border: none;
    padding: 0;
}

#user-role-note, #user-type-note {
    height: auto;
    margin-bottom: 1;
}

#user-modal Checkbox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#user-complaint {
    height: auto;
}
