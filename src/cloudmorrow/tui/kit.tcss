/* The kit in the terminal: Quill screens, the record sheet, and the Quills
   section of Administration. Everything else is in cloudmorrow.tcss. */

/* -- board ---------------------------------------------------------------- */
/* The groups, as a strip of tabs: which ones you have, without a click. The
   strip's own underline is the rule under it; a border here would be two. */
#board-bar {
    height: 2;
    padding: 0;
    background: transparent;
}

#board-nav {
    width: 1fr;
    height: 2;
    background: transparent;
}

#board-nav Tab {
    padding: 0 2;
}

#lanes {
    height: 1fr;
}

.lane {
    width: 1fr;
    border-right: solid $line;
}

.lane:last-of-type {
    border-right: none;
}

/* The lane a held card would land in, so a drop is never a guess. */
.lane.-drop-target {
    background: $panel;
}

.lane-head {
    height: 1;
    padding: 0 1;
    background: transparent;
}

.lane-body {
    height: 1fr;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

.record-card {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: $surface;
    border-left: solid $line;
}

.record-card:hover {
    border-left: solid $secondary;
}

.record-card:focus {
    background: $panel;
    border-left: solid $primary;
}

/* Held, and on its way somewhere. */
.record-card.-dragging {
    background: $panel;
    border-left: solid $primary;
    text-style: bold;
}

/* -- list ----------------------------------------------------------------- */
#kit-table {
    height: 1fr;
    margin-top: 1;
}

/* -- the record sheet ----------------------------------------------------- */
#record-sheet {
    max-height: 90%;
}

#sheet-fields {
    height: auto;
    max-height: 62vh;
    scrollbar-size-vertical: 1;
}

.sheet-row {
    height: auto;
    margin-bottom: 1;
}

.sheet-label {
    width: 12;
    color: $muted;
}

.sheet-row Input, .sheet-row Select, .sheet-row .sheet-fixed {
    width: 1fr;
}

.sheet-row Input {
    background: $surface;
}

.sheet-row Input:focus {
    background: $panel;
}

.sheet-fixed {
    height: auto;
}

.sheet-row .sheet-radios {
    width: 1fr;
    height: auto;
    layout: horizontal;
    background: transparent;
}

.sheet-radios RadioButton {
    width: auto;
    margin-right: 2;
    background: transparent;
}

.sheet-row Checkbox {
    background: transparent;
}

.sheet-row .sheet-markdown {
    width: 1fr;
    height: 10;
    border: solid $line;
    background: $background;
}

.sheet-row .sheet-text {
    width: 1fr;
    height: 5;
    background: $background;
}

#sheet-complaint {
    margin: 0;
}

/* -- Administration: Quills ------------------------------------------------ */
#quill-sheet-body, #quill-services-body, #shelves-body {
    height: auto;
    max-height: 62vh;
    scrollbar-size-vertical: 1;
}

#quill-sheet-body Static, #quill-services-body Static, #shelves-body Static {
    height: auto;
}

/* People's own Quills and the requests (admin_quills.ShelvesModal): a line
   each, and its buttons under it. */
.shelves-buttons {
    height: auto;
    margin: 0 0 1 2;
}

.shelves-buttons Button {
    height: 1;
    min-width: 6;
    margin-right: 1;
    padding: 0 1;
}

/* The Quill actions on a record (tui/quill_actions.py), under its fields. */
#sheet-actions {
    height: auto;
    margin-top: 1;
}

#sheet-actions Button {
    height: 1;
    min-width: 6;
    margin-right: 1;
    padding: 0 1;
    border: none;
    color: $foreground;
    background: $panel;
}

#sheet-actions Button:hover {
    background: $line-bright;
}

#sheet-actions Button.-primary {
    color: $action-ink;
    background: $action;
    text-style: bold;
}

#sheet-actions Button.-error {
    color: $error;
    background: transparent;
}

#action-fields {
    height: auto;
    max-height: 62vh;
    scrollbar-size-vertical: 1;
}

.action-fields {
    height: auto;
}

/* A long text in an action's form sits on the page, not in a dialog of its
   own: it needs the input's ground to be seen as a box. */
.action-fields .sheet-text {
    background: $surface;
}

/* A record's history under its fields: who did what, when; never a value. */
.sheet-history {
    margin: 1 1 0 1;
    color: $text-muted;
}
