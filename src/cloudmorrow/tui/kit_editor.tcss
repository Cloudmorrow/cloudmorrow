/* The kit's editor in the terminal: the tree of folders and pages, the live
   Markdown editor beside it, and the picture the cursor is on. */

#editor-body {
    height: 1fr;
}

#editor-tree {
    width: 26;
    background: transparent;
    border-right: solid $line;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

#editor-tree:focus {
    border-right: solid $primary;
}

#editor-pane {
    width: 1fr;
}

#editor-path {
    height: 1;
    padding: 0 2;
    background: transparent;
    color: $secondary;
    text-style: bold;
}

#editor {
    padding: 1 2;
    background: $background;
    scrollbar-size: 1 1;
}

#editor-row {
    height: 1fr;
}

/* The picture the cursor is on, beside the text. Hidden when there is none. */
#picture {
    width: 40%;
    height: 1fr;
    padding: 1 2;
    background: transparent;
    border-left: solid $line;
}

#picture-caption {
    height: auto;
    margin-bottom: 1;
}

/* auto on both sides is the one pairing textual-image fits to the panel
   whole, keeping the picture's shape; a fixed width leaves it no height. */
#picture .picture-image {
    width: auto;
    height: auto;
}

#editor:focus {
    background: $background;
}
